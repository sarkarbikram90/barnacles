# Auto-detect text files and perform LF normalization on checkout
* text=auto

# Go source files must strictly use LF line endings
*.go text eol=lf

# Shell scripts must strictly use LF
*.sh text eol=lf

# Configuration and documentation
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
